# Hub Core configuration
# Copie ce fichier en .env et remplis les valeurs

# App
APP_NAME=hub-core
APP_ENV=dev
LOG_LEVEL=INFO

# Database (PostgreSQL)
# En Docker, le host est 'postgres' (nom du service)
# En local sans Docker, c'est 'localhost'
DATABASE_URL=postgresql+psycopg://hub:hubpass@postgres:5432/hubdb

# Ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:14b-instruct
OLLAMA_EMBED_MODEL=nomic-embed-text

# CORS — origines autorisées séparées par virgule
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Sécurité (à régénérer pour ta machine !)
# Génère avec : python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=changeme-changeme-changeme-changeme

# Cloudflare Access (Phase 0+) — récupéré dans Cloudflare Zero Trust dashboard
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUDIENCE=
